APP_NAME="Taxidiotes Game"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS=travelers@example.org
MAIL_FROM_NAME="${APP_NAME}"

# Various app settings
DEFAULT_USER_PASSWORD_FOR_SEED=develop

# Mailgun
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.eu.mailgun.net

# Sentry
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_ENVIRONMENT=local

# Google Analytics
GOOGLE_ANALYTICS_ID=

# Development environment variables --------------------------------------------

# Laravel Boost, the AI agent toolkit: Set false to switch it off.
BOOST_ENABLED=true
# How Boost runs PHP: *empty* for local PHP, `ddev` under DDEV.
BOOST_PHP_EXECUTABLE_PATH=
# How Boost runs Composer: *empty* for local, `ddev composer` under DDEV.
BOOST_COMPOSER_EXECUTABLE_PATH=
# How Boost runs npm: *empty* for local, `ddev npm` under DDEV.
BOOST_NPM_EXECUTABLE_PATH=
# How Boost runs tools in vendor/bin: *empty* for local, `ddev exec vendor/bin/` under DDEV.
BOOST_VENDOR_BIN_EXECUTABLE_PATH=
